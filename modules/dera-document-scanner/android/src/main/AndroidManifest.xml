<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Android 12 and below: read shared storage (MediaStore + file walk on Android 10 with legacy storage). -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
  <!-- Android 11+: optional "All files access". The user grants it in system settings; the app works without it via SAF. -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

  <application android:requestLegacyExternalStorage="true">
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.dera.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/dera_file_paths" />
    </provider>
  </application>
</manifest>
