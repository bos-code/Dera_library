<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/dera_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/dera_widget_bg"
  android:orientation="vertical"
  android:padding="14dp">

  <TextView
    android:id="@+id/dera_widget_today"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textColor="@color/dera_widget_accent"
    android:textSize="13sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:ellipsize="end"
    android:text="Dera Library" />

  <TextView
    android:id="@+id/dera_widget_doc1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:minHeight="28dp"
    android:gravity="center_vertical"
    android:textColor="@color/dera_widget_text"
    android:textSize="14sp"
    android:maxLines="1"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/dera_widget_doc2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="28dp"
    android:gravity="center_vertical"
    android:textColor="@color/dera_widget_text"
    android:textSize="14sp"
    android:maxLines="1"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/dera_widget_doc3"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="28dp"
    android:gravity="center_vertical"
    android:textColor="@color/dera_widget_text"
    android:textSize="14sp"
    android:maxLines="1"
    android:ellipsize="end" />

  <TextView
    android:id="@+id/dera_widget_empty"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:textColor="@color/dera_widget_muted"
    android:textSize="13sp"
    android:text="Open a document in Dera and it appears here." />
</LinearLayout>
